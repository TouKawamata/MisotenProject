{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "a33e967a811a4bbe86bc2fc149cfd924",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "QuadClip (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -839.0000610351563,
            "y": 61.00000762939453,
            "width": 207.00006103515626,
            "height": 173.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "b56c6e8d3e2d40dcb273fd39ed323063"
        },
        {
            "m_Id": "d99a2048d83b4de9a52ea4baf264533c"
        },
        {
            "m_Id": "d9474cb8820744d3ac401d4973f87cdc"
        },
        {
            "m_Id": "2a02a65f48fa4ff2b30c59f0d6140455"
        },
        {
            "m_Id": "48eb1326902f484e85395dec12a256cd"
        },
        {
            "m_Id": "ad3d46b98626427dbbb049badc8f3532"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "QuadClip",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// 各辺と点Pの外積（2Dクロス積）を計算\r\nfloat e1 = (B.x - A.x) * (P.y - A.y) - (B.y - A.y) * (P.x - A.x);\r\nfloat e2 = (C.x - B.x) * (P.y - B.y) - (C.y - B.y) * (P.x - B.x);\r\nfloat e3 = (D.x - C.x) * (P.y - C.y) - (D.y - C.y) * (P.x - C.x);\r\nfloat e4 = (A.x - D.x) * (P.y - D.y) - (A.y - D.y) * (P.x - D.x);\r\n\r\n// 全ての辺に対して同じ側（内側）にあるか判定（時計回り・反時計回り両対応）\r\nif ((e1 >= 0 && e2 >= 0 && e3 >= 0 && e4 >= 0) || (e1 <= 0 && e2 <= 0 && e3 <= 0 && e4 <= 0)) {\r\n    Out = 1.0; // 内側\r\n} else {\r\n    Out = 0.0; // 外側\r\n}"
}

